	(text "Diamond Mine Shimmer Circuit\nFinal Corrected Design — Feb 2026\n\nSolar-charged, dusk-activated LED shimmer\nCD4093 + NPN (Q1) + PNP (Q2,Q3) topology"
		(exclude_from_sim no)
		(at 25.4 10 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "bbbb0001-0001-0001-0001-000000000001")
	)
	(text "SECTION A: POWER\nSolar 5.5V parallel → R_charge 10R → 1N5819 → 3xAA NiMH 3.6V"
		(exclude_from_sim no)
		(at 25.4 35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbbb0001-0001-0001-0001-000000000002")
	)
	(text "SECTION B: DUSK DETECTOR\nVDD → LDR → SENSE → Pin1+Pin2 → Pin3 (DARK)\nSENSE → 470k → (100k trim || 47k) → GND"
		(exclude_from_sim no)
		(at 95 55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbbb0001-0001-0001-0002-000000000001")
	)
	(text "SECTION C: IC + OSCILLATORS\nGate 1: Dusk (inv)  Pin1+2→3\nGate 2: Osc1 (gated) Pin5+6→4\nGate 3: Osc2 (gated) Pin8+9→10\nGate 4: Unused Pin12+13→11 (VDD)"
		(exclude_from_sim no)
		(at 130 75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbbb0001-0001-0001-0003-000000000001")
	)
	(text "SECTION G: LED DRIVERS\nQ1 (2N3904 NPN): FADE→10k→base, Steady LEDs VDD→1.5k→LED→Q1col\nQ2 (2N3906 PNP): OSC1→100k→base, Twinkle1 VDD→Q2emit→Q2col→LED→2.2k→GND\nQ3 (2N3906 PNP): OSC2→100k→base, Twinkle2 VDD→Q3emit→Q3col→LED→2.2k→GND"
		(exclude_from_sim no)
		(at 200 95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbbb0001-0001-0001-0005-000000000001")
	)
